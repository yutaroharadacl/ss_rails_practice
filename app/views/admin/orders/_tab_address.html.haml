#tab-address.tab-pane
  =render layout: 'panel', locals: { title: 'お届け先住所' } do
    =form_with model: [:admin, @order], method: :patch, local: true do |f|
      = hidden_field_tag :tab, 'tab-address'
      %fieldset{disabled: !@order.editable?}
        =render layout: 'panel_input_row', locals: { f: f, field: :shipping_postal_code, label: '郵便番号' } do
          = f.text_field :shipping_postal_code, class: 'form-control'
        =render layout: 'panel_input_row', locals: { f: f, field: :shipping_prefecture, label: '都道府県' } do
          = f.text_field :shipping_prefecture, class: 'form-control'
        =render layout: 'panel_input_row', locals: { f: f, field: :shipping_city, label: '市区町村' } do
          = f.text_field :shipping_city, class: 'form-control'
        =render layout: 'panel_input_row', locals: { f: f, field: :shipping_address_line, label: '番地' } do
          = f.text_field :shipping_address_line, class: 'form-control'
      .text-right
        = f.submit '保存する', class: 'btn btn-primary'
