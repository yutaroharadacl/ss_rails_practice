%h1 ショッピングカート
- if @cart.nil? || @cart.cart_items.empty?
  %p カートは空です
- else
  %table.table.table-middle
    %thead
      %tr
        %th 商品名
        %th 数量
        %th 価格
        %th 操作
    %tbody
      - @cart.cart_items.each do |item|
        %tr
          %td ダミーアイテム
          = render 'cart_items/quantity_form', item: item
          -# productテーブルができたらそこから取り出す
          %td 価格
          %td
            = button_to '削除', cart_item_path(item), method: :delete, class: 'btn btn-danger'
  .cart-summary
    %p
      合計金額: #{number_to_currency(@cart.total_price)}
    = link_to 'レジに進む', new_cart_order_path, class: 'btn btn-primary'
