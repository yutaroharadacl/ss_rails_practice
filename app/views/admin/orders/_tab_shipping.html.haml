#tab-shipping.tab-pane
  =render layout: 'panel', locals: { title: '配送情報' } do
    =form_with model: [:admin, @order], method: :patch, local: true do |f|
      = hidden_field_tag :tab, 'tab-shipping'
      %fieldset{disabled: !@order.editable?}
        =render layout: 'panel_input_row', locals: { f: f, field: :status, label: '対応状況' } do
          = f.select :status, Order::STATUS_LABELS.map { |value, label| [label, value] }, {}, class: 'form-control', onchange: 'this.form.submit();'
        =render layout: 'panel_input_row', locals: { f: f, field: :desired_delivery_date, label: 'お届け日' } do
          = f.date_field :desired_delivery_date, class: 'form-control'
      .text-right
        = f.submit '保存する', class: 'btn btn-primary'
