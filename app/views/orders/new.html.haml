%h1 注文確認

- if @cart.nil? || @cart.cart_items.empty?
  %p カートは空です
  = link_to 'カートへ戻る', cart_path
- else
  %table.table.table-middle
    %thead
      %tr
        %th 商品名
        %th 数量
        %th 単価
    %tbody
      - @cart.cart_items.each do |item|
        %tr
          %td ダミーアイテム
          %td= item.quantity
          -# productテーブルが完成次第変える
          %td 単価
        %tr
          %td.text-right{colspan: 2} 小計
          %td= number_to_currency(@cart.total_price)

  .text-right
    = button_to '注文を確定する', orders_path, method: :post, class: 'btn btn-primary'