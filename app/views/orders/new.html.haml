%h1 注文確認

- if @cart.nil? || @cart.cart_items.empty?
  %p カートは空です
  = link_to 'カートへ戻る', cart_path
- else
  %table.table.table-middle
    %thead
      %tr
        %th 商品名
        %th 数量
        %th 単価
    %tbody
      - @cart.cart_items.each do |item|
        %tr
          %td ダミーアイテム
          %td= item.quantity
          -# productテーブルが完成次第変える
          %td 単価
      %tr
        %td.text-right{colspan: 2} 小計
        %td= number_to_currency(@cart.total_price)

  %h2 お届け先住所
  =form_with model: @order, url: cart_orders_path, local: true do |f|
    .form-group
      .row
        .col-xs-4
          = f.label :shipping_postal_code, '郵便番号'
          = f.text_field :shipping_postal_code, class: 'form-control'
    .form-group
      .row
        .col-xs-6
          = f.label :shipping_prefecture, '都道府県'
          = f.text_field :shipping_prefecture, class: 'form-control'
        .col-xs-6
          = f.label :shipping_city, '市区町村'
          = f.text_field :shipping_city, class: 'form-control'
    .form-group
      = f.label :shipping_address_line, '番地'
      = f.text_field :shipping_address_line, class: 'form-control'
    .text-right
      = f.submit '注文を確定する', class: 'btn btn-primary'