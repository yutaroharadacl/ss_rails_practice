!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title SsRailsPractice
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application'
  %body
    .container-fluid
      .row
        .col-sm-2.sidebar-menu
          = render 'layouts/sidebar'
        .col-sm-8
          - flash.each do |type, message|
            - css_class = { 'notice' => 'success', 'alert' => 'danger' }[type]
            .alert{class: "alert-#{css_class}"}
              = message
          = yield
