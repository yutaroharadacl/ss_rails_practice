#tab-items.tab-pane
  -# パネル見出しの右側に置くボタン。data属性だけでBootstrapのモーダルが開くのでJSは不要。
  -# type: 'button' を省略するとsubmit扱いになるため明示している。
  - add_product_button = button_tag('商品を追加', type: 'button', class: 'btn btn-primary', data: { toggle: 'modal', target: '#add-product-modal' }) if @order.editable?
  =render layout: 'panel', locals: { title: '受注商品管理', action: add_product_button } do
    =form_with model: [:admin, @order], method: :patch, local: true do |f|
      = hidden_field_tag :tab, 'tab-items'
      %fieldset{disabled: !@order.editable?}
        %table.table.table-middle
          %thead
            %tr
              %th 商品名
              %th SKUコード
              %th 単価
              %th 個数
              %th 削除
              %th 小計
          %tbody
            = f.fields_for :order_items do |item_form|
              %tr
                = item_form.hidden_field :id
                %td= item_form.object.product&.name || '削除された商品'
                %td= item_form.object.product&.sku&.code || '-'
                %td
                  = item_form.number_field :price
                  円
                %td
                  = item_form.number_field :quantity
                  個
                %td= item_form.check_box :_destroy
                %td= number_to_currency(item_form.object.subtotal)
            %tr
              %td.text-right{colspan: 5} 小計
              %td= number_to_currency(@order.subtotal)
            %tr
              %td.text-right{colspan:5} 消費税
              %td= number_to_currency(@order.tax)
            %tr.total-row
              %td.text-right{colspan:5} 合計
              %td.text-color-red= number_to_currency(@order.total)
        .text-right
          = f.submit '保存する', class: 'btn btn-primary'
