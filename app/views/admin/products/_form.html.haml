= form_with model: [@store, @product], url: (@product.persisted? ? admin_store_product_path(@store, @product) : admin_store_products_path(@store)), local: true do |f|
  - if @product.errors.any?
    .alert.alert-danger
      %ul
        - @product.errors.full_messages.each do |message|
          %li= message

  .form-group
    = f.label :name, '商品名'
    = f.text_field :name, class: 'form-control'

  .form-group
    = f.label :description, '説明'
    = f.text_area :description, class: 'form-control', rows: 3

  .form-group
    = f.check_box :published
    = f.label :published, '公開する'

  %h3 SKU
  = f.fields_for :sku do |sf|
    -# 更新時に既存 SKU を特定するため id を送る（product_params の :id と対応）
    = sf.hidden_field :id if sf.object.persisted?

    .form-group
      = sf.label :code, 'SKUコード'
      = sf.text_field :code, class: 'form-control'

    .form-group
      = sf.label :price, '価格（円）'
      = sf.number_field :price, class: 'form-control', min: 0

    .form-group
      = sf.label :stock_quantity, '在庫数'
      = sf.number_field :stock_quantity, class: 'form-control', min: 0

  = f.submit (@product.persisted? ? '更新する' : '登録する'), class: 'btn btn-primary'
  = link_to '戻る', admin_store_products_path(@store), class: 'btn btn-default'