%h1 注文一覧

- if @orders.empty?
  %p 注文はまだありません
- else
  %table.table.table-striped.table-bordered
    %thead
      %tr
        %th 注文番号
        %th 注文日時
        %th ステータス
        %th 決済
        %th
    %tbody
      - @orders.each do |order|
        %tr
          %td= order.order_number
          %td= l(order.created_at, format: :short) rescue order.created_at
          %td= Order::STATUS_LABELS[order.status] || order.status
          %td= order.payment_status
          %td= link_to '詳細', order_path(order.order_number)