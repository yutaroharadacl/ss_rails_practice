%h1 受注管理

%ul.nav.nav-tabs{role: 'tablist'}
  %li.active{role: 'presentation'}
    %a{href: '#tab-basic', data: { toggle: 'tab' }} 基本情報
  %li{role: 'presentation'}
    %a{href: '#tab-address', data: { toggle: 'tab' }} お届け先住所
  %li{role: 'presentation'}
    %a{href: '#tab-shipping', data: { toggle: 'tab' }} 配送情報
  %li{role: 'presentation'}
    %a{href: '#tab-items', data: { toggle: 'tab' }} 受注商品管理

.tab-content
  = render 'tab_basic'
  = render 'tab_address'
  = render 'tab_shipping'
  = render 'tab_items'

-# モーダルは既存のform_withと入れ子にならないよう.tab-contentの外に置く
- if @order.editable?
  = render 'add_product_modal'
